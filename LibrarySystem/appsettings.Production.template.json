{
  "AllowedHosts": "library.example.edu",
  "ConnectionStrings": {
    "DefaultConnection": "Server=SQL_SERVER;Database=LibrarySystem;Encrypt=True;TrustServerCertificate=False;Integrated Security=True"
  },
  "DataProtection": {
    "KeysPath": "C:\\ProgramData\\LibrarySystem\\DataProtectionKeys"
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownProxies": [
      "10.0.0.10"
    ]
  },
  "Notifications": {
    "Delivery": {
      "MaximumAttempts": 5,
      "BatchSize": 50,
      "LeaseMinutes": 5,
      "MaximumRetryDelayMinutes": 60
    },
    "Smtp": {
      "Host": "smtp.example.edu",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "SET_IN_SECRET_STORE",
      "Password": "SET_IN_SECRET_STORE",
      "FromAddress": "library@nvsu.edu.ph",
      "FromName": "School Library"
    }
  },
  "IdentitySeed": {
    "EnableAdministratorBootstrap": false,
    "AdministratorEmail": "admin@nvsu.edu.ph",
    "AdministratorPassword": "SET_IN_SECRET_STORE",
    "EnableTemporaryLibrarian": false
  },
  "Identity": {
    "Links": {
      "PublicBaseUrl": "https://library.example.edu",
      "TokenLifetimeMinutes": 60
    }
  },
  "DataRetention": {
    "Enabled": false,
    "AuditLogDays": 2555,
    "TerminalNotificationDays": 90,
    "BatchSize": 500,
    "IntervalHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
