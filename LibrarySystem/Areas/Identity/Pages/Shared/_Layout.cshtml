<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] | School Library</title>
    <link rel="stylesheet" href="~/css/identity-layout.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#identity-content">Skip to content</a>
    <header class="app-header">
        <a class="brand" asp-area="" asp-page="/Index" aria-label="School Library home">
            <span class="seal" aria-hidden="true">
<svg viewBox="0 0 48 48">
<path d="M8 9.5A4.5 4.5 0 0 1 12.5 5H22a6 6 0 0 1 6 6v29a6 6 0 0 0-6-6h-9.5A4.5 4.5 0 0 0 8 38.5v-29Z"/>
<path d="M40 9.5A4.5 4.5 0 0 0 35.5 5H28v35a6 6 0 0 1 6-6h1.5a4.5 4.5 0 0 1 4.5 4.5v-29Z"/>
</svg>
</span>
            <span>School Library</span>
        </a>
        <nav class="identity-nav" aria-label="Account navigation">
            @if (User.Identity?.IsAuthenticated == true){
<a asp-area="" asp-page="/Dashboards/LibrarianDashboard">Dashboard</a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login" method="post">
<button type="submit">Sign out</button>
</form>
}
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login">Sign in</a>
}
        </nav>
    </header>
    <main id="identity-content" class="identity-content">
<section class="identity-card" aria-labelledby="page-title">@RenderBody()</section>
</main>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
