@page
@model LibrarySystem.Areas.Identity.Pages.Account.ChangePasswordModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Change password";
}

<section aria-labelledby="page-title">
    <h1 id="page-title">@(Model.IsFirstLogin ? "Secure your account" : "Change password")</h1>
    <p class="lead">
        @(Model.IsFirstLogin
                ? "Replace the temporary password before continuing."
                : "Enter your current password and choose a new one.")
    </p>

    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert">
</div>
        <input asp-for="Input.ReturnUrl" type="hidden" />

        <div class="field-group">
            <label asp-for="Input.CurrentPassword">
</label>
            <input asp-for="Input.CurrentPassword"
                   type="password"
                   autocomplete="current-password"
                   autofocus />
            <span asp-validation-for="Input.CurrentPassword" class="field-error">
</span>
        </div>

        <div class="field-group">
            <label asp-for="Input.NewPassword">
</label>
            <input asp-for="Input.NewPassword"
                   type="password"
                   autocomplete="new-password"
                   aria-describedby="new-password-hint" />
            <p id="new-password-hint" class="help-copy">
                Choose something you don't use anywhere else.
            </p>
            <span asp-validation-for="Input.NewPassword" class="field-error">
</span>
        </div>

        <div class="field-group">
            <label asp-for="Input.ConfirmPassword">
</label>
            <input asp-for="Input.ConfirmPassword"
                   type="password"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error">
</span>
        </div>

        <button class="submit-button" type="submit">Change password</button>
    </form>
@if (!Model.IsFirstLogin){
<nav class="identity-links" aria-label="What to do next">
            <a asp-area="" asp-page="/Dashboards/LibrarianDashboard">Cancel</a>
        </nav>
}
</section>
