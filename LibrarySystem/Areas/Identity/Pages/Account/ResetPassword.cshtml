@page
@model LibrarySystem.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reset password";
}

<section aria-labelledby="page-title">
    <h1 id="page-title">Choose a new password</h1>
    <p class="lead" id="password-requirements">
        Use at least 12 characters with uppercase, lowercase, number, and symbol.
    </p>

    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert">
</div>
        <input asp-for="Input.UserId" type="hidden" />
        <input asp-for="Input.Code" type="hidden" />

        <div class="field-group">
            <label asp-for="Input.Password">
</label>
            <input asp-for="Input.Password"
                   type="password"
                   autocomplete="new-password"
                   autofocus
                   aria-describedby="password-requirements" />
            <span asp-validation-for="Input.Password" class="field-error">
</span>
        </div>

        <div class="field-group">
            <label asp-for="Input.ConfirmPassword">
</label>
            <input asp-for="Input.ConfirmPassword"
                   type="password"
                   autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error">
</span>
        </div>

        <button class="submit-button" type="submit">Reset password</button>
    </form>

    <nav class="identity-links" aria-label="What to do next">
        <a asp-page="./Login">Return to sign in</a>
    </nav>
</section>
