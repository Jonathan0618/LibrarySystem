@page
@model LibrarySystem.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Password reset";
}

<section aria-labelledby="page-title">
    <h1 id="page-title">Password changed</h1>
    <p class="lead">Your password has been reset. Existing sessions will be revalidated.</p>

    <div class="status-panel success" role="status">
        You can now sign in with your new password.
    </div>

    <nav class="identity-links" aria-label="What to do next">
        <a asp-page="./Login">Sign in</a>
    </nav>
</section>
