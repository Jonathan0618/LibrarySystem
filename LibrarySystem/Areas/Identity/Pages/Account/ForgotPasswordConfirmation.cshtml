@page
@model LibrarySystem.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reset requested";
}

<section aria-labelledby="page-title">
    <h1 id="page-title">Check your email</h1>
    <p class="lead">
        If an active, confirmed account matches that address, password-reset instructions have been queued.
    </p>

    <div class="status-panel" role="status">
        For privacy, this page does not confirm whether an account exists. Reset links expire
        after the configured security period.
    </div>

    <nav class="identity-links" aria-label="What to do next">
        <a asp-page="./Login">Return to sign in</a>
    </nav>
</section>
