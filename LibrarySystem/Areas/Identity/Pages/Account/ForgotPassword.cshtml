@page
@model LibrarySystem.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot password";
}

<section aria-labelledby="page-title">
    <h1 id="page-title">Reset your password</h1>
    <p class="lead">
        Enter your confirmed school email. We'll send instructions if the account is eligible.
    </p>

    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert">
</div>

        <div class="field-group">
            <label asp-for="Input.Email">
</label>
            <input asp-for="Input.Email"
                   type="email"
                   autocomplete="email"
                   autofocus
                   placeholder="name@school.edu" />
            <span asp-validation-for="Input.Email" class="field-error">
</span>
        </div>

        <button class="submit-button" type="submit">Send reset instructions</button>
    </form>

    <nav class="identity-links" aria-label="What to do next">
        <a asp-page="./Login">Return to sign in</a>
        <a asp-page="./ResendEmailConfirmation">Resend confirmation</a>
    </nav>
</section>
